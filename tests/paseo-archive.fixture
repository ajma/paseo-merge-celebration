import { test, expect, vi } from "vitest";
import { cp, mkdir, mkdtemp, rm, writeFile, chmod } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { execFileSync } from "node:child_process";
import { DaemonClient } from "../test-utils/daemon-client.js";
import { createTestPaseoDaemon } from "../test-utils/paseo-daemon.js";
import { createPaseoApi } from "@getpaseo/client";
import {
  WorkspaceGitServiceImpl,
  type WorkspaceGitRuntimeSnapshot,
} from "../workspace-git-service.js";

test.each(["manual", "automatic"])(
  "merge celebration delivers a %s archive through the live client",
  async (mode) => {
    const root = await mkdtemp(join(tmpdir(), "paseo-celebration-e2e-"));
    const pluginPath = process.env.MERGE_PLUGIN_DIR!;
    const plugin = join(root, "plugin");
    const repository = join(root, "repository");
    const bin = join(root, "bin");
    const previousPath = process.env.PATH;
    await mkdir(plugin);
    await mkdir(repository);
    await mkdir(bin);
    for (const name of [
      "index.server.ts",
      "index.client.tsx",
      "paseo-plugin.json",
      "server",
      "shared",
      "client",
    ]) {
      await cp(join(pluginPath, name), join(plugin, name), { recursive: true });
    }
    function git(...args: string[]) {
      return execFileSync("git", ["-C", repository, ...args], { encoding: "utf8" }).trim();
    }
    git("init", "-b", "feature");
    git(
      "-c",
      "user.name=Test",
      "-c",
      "user.email=test@example.com",
      "commit",
      "--allow-empty",
      "-m",
      "Feature",
    );
    git("remote", "add", "origin", "https://github.com/example/celebration-fixture.git");
    const sha = git("rev-parse", "HEAD");
    const statePath = join(root, "pr.json");
    const pr = {
      number: 7,
      title: "Ship feature",
      url: "https://github.com/example/celebration-fixture/pull/7",
      state: "MERGED",
      mergedAt: "2026-01-01T00:00:00Z",
      headRefOid: sha,
      closingIssuesReferences: [
        { number: 3, url: "https://github.com/example/celebration-fixture/issues/3" },
      ],
    };
    await writeFile(statePath, JSON.stringify(pr));
    const ghPath = join(bin, "gh");
    await writeFile(
      ghPath,
      `#!${process.execPath}\nconst fs = require("fs"); const pr = JSON.parse(fs.readFileSync(${JSON.stringify(statePath)}, "utf8")); const args = process.argv.slice(2); if(pr.error) process.exit(1); console.log(JSON.stringify(args[0] === "pr" ? pr : args[1].includes("/issues/") ? {number:3,title:"Issue recap",body:"Shipped the requested change."} : [{number:7,head:{sha:pr.headRefOid}}]));\n`,
    );
    await chmod(ghPath, 0o755);
    process.env.PATH = `${bin}:${previousPath}`;
    const listeners: Array<(snapshot: WorkspaceGitRuntimeSnapshot) => void> = [];
    let mergedSnapshot: WorkspaceGitRuntimeSnapshot | undefined;
    if (mode === "automatic") {
      const observe = WorkspaceGitServiceImpl.prototype.onSnapshotUpdated;
      vi.spyOn(WorkspaceGitServiceImpl.prototype, "onSnapshotUpdated").mockImplementation(
        function (listener) {
          listeners.push(listener);
          return observe.call(this, listener);
        },
      );
      const getSnapshot = WorkspaceGitServiceImpl.prototype.getSnapshot;
      vi.spyOn(WorkspaceGitServiceImpl.prototype, "getSnapshot").mockImplementation(
        function (cwd, options) {
          if (options?.reason === "auto-archive-on-merge" && mergedSnapshot)
            return Promise.resolve(mergedSnapshot);
          return getSnapshot.call(this, cwd, options);
        },
      );
    }
    const daemon = await createTestPaseoDaemon({
      daemonVersion: "0.11.2",
      pluginsEnabled: true,
      autoArchiveAfterMerge: mode === "automatic",
    });
    const client = new DaemonClient({
      url: `ws://127.0.0.1:${daemon.port}/ws`,
      appVersion: "0.11.2",
    });
    let stopEvents = () => {};
    try {
      await client.connect();
      const installed = await client.installDirectoryPlugin(plugin);
      expect(installed.status).toBe("running");
      expect(
        await client.invokePluginRpc("paseo-merge-celebration", "celebrations.diagnose", {
          preview: false,
        }),
      ).toEqual({ clients: 0, previewId: null });
      git("switch", "-c", "main");
      const created = await client.createWorkspace({
        source: { kind: "worktree", cwd: repository, action: "checkout", refName: "feature" },
      });
      expect(created.error).toBeNull();
      const id = created.workspace!.id;
      const { startLiveEvents } = await import(join(pluginPath, "client/events.ts"));
      const { createCelebrationStore } = await import(join(pluginPath, "client/store.ts"));
      const store = createCelebrationStore();
      stopEvents = startLiveEvents(
        {
          paseo: createPaseoApi(client),
          rpc: (contract: { name: string }, input: unknown) =>
            client.invokePluginRpc("paseo-merge-celebration", contract.name, input),
        },
        store,
      );
      await expect
        .poll(async () =>
          (await client.getPluginLogs("paseo-merge-celebration")).some((entry) =>
            entry.message.includes("Desktop/browser client ready"),
          ),
        )
        .toBe(true);
      const poll = (baseline: boolean) =>
        client.invokePluginRpc("paseo-merge-celebration", "celebrations.poll", {
          session: "live",
          baseline,
        });
      expect(await poll(true)).toEqual({ events: [] });
      const diagnostic = (await client.invokePluginRpc(
        "paseo-merge-celebration",
        "celebrations.diagnose",
        { preview: true },
      )) as { clients: number; previewId: string };
      expect(diagnostic.clients).toBe(2);
      await expect
        .poll(() => store.getSnapshot()?.id, { timeout: 5000 })
        .toBe(diagnostic.previewId);
      expect(await poll(false)).toMatchObject({ events: [{ id: diagnostic.previewId }] });
      store.dismiss();
      if (mode === "automatic") {
        // Drive the actual daemon auto-archive controller at its forge observation boundary.
        // Registry mutation, lifecycle hook, cleanup, RPC and client are all real.
        mergedSnapshot = {
          cwd: created.workspace!.workspaceDirectory,
          git: { isGit: true, isDirty: false, aheadOfOrigin: 0 },
          forge: {
            pullRequest: { url: pr.url, headRefName: "feature", isMerged: true, state: "merged" },
          },
        } as WorkspaceGitRuntimeSnapshot;
        const open = {
          ...mergedSnapshot,
          forge: {
            ...mergedSnapshot.forge,
            pullRequest: { ...mergedSnapshot.forge.pullRequest!, isMerged: false, state: "open" },
          },
        };
        for (const listener of listeners) listener(open);
        for (const listener of listeners) listener(mergedSnapshot);
      } else expect((await client.archiveWorkspace(id)).error).toBeNull();
      await expect
        .poll(() => poll(false), { timeout: 15_000, interval: 100 })
        .toMatchObject({
          events: [
            {
              title: "Ship feature",
              issues: [
                { number: 3, title: "Issue recap", summary: "Shipped the requested change." },
              ],
            },
          ],
        });
      await expect.poll(() => store.getSnapshot()?.title, { timeout: 5000 }).toBe("Ship feature");
      stopEvents();
      expect(await poll(false)).toEqual({ events: [] });
      await client.archiveWorkspace(id);
      expect(await poll(false)).toEqual({ events: [] });
      expect(
        await client.invokePluginRpc("paseo-merge-celebration", "celebrations.poll", {
          session: "reconnected",
          baseline: true,
        }),
      ).toEqual({ events: [] });
      await client.reloadPlugin("paseo-merge-celebration");
      expect(await poll(true)).toEqual({ events: [] });
      // A second workspace on the same repo represents manual archiving of an open PR.
      await writeFile(statePath, JSON.stringify({ ...pr, state: "OPEN", mergedAt: null }));
      const unmerged = await client.createWorkspace({
        source: { kind: "directory", path: repository },
      });
      expect(unmerged.error).toBeNull();
      expect((await client.archiveWorkspace(unmerged.workspace!.id)).error).toBeNull();
      // Await a normal RPC round-trip and confirm no event was published after verification.
      await new Promise((resolve) => setTimeout(resolve, 1000));
      expect(await poll(false)).toEqual({ events: [] });
      const logs = await client.getPluginLogs("paseo-merge-celebration");
      expect(logs.filter((entry) => entry.message.includes("Merge verification failed"))).toEqual(
        [],
      );
      await writeFile(statePath, JSON.stringify({ ...pr, error: true }));
      const unavailable = await client.createWorkspace({
        source: { kind: "directory", path: repository },
      });
      expect(unavailable.error).toBeNull();
      expect((await client.archiveWorkspace(unavailable.workspace!.id)).error).toBeNull();
      await expect
        .poll(
          async () =>
            (await client.getPluginLogs("paseo-merge-celebration")).some((entry) =>
              entry.message.includes("Merge verification failed"),
            ),
          { timeout: 5000 },
        )
        .toBe(true);
      expect(await poll(false)).toEqual({ events: [] });
      expect(
        (await client.listPlugins()).find((entry) => entry.id === "paseo-merge-celebration")
          ?.status,
      ).toBe("running");
    } catch (error) {
      console.error("Plugin logs", await client.getPluginLogs("paseo-merge-celebration"));
      throw error;
    } finally {
      stopEvents();
      process.env.PATH = previousPath;
      await client.close();
      await daemon.close();
      vi.restoreAllMocks();
      await rm(root, { recursive: true, force: true });
    }
  },
  60_000,
);
