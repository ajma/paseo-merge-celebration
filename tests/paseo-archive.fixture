import { test, expect } from "vitest";
import { cp, mkdir, mkdtemp, rm, writeFile, chmod } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { execFileSync } from "node:child_process";
import { DaemonClient } from "../test-utils/daemon-client.js";
import { createTestPaseoDaemon } from "../test-utils/paseo-daemon.js";

test("merge celebration observes real archive hooks and delivers one live RPC event", async () => {
  const root = await mkdtemp(join(tmpdir(), "paseo-celebration-e2e-"));
  const pluginPath = process.env.MERGE_PLUGIN_DIR!;
  const plugin = join(root, "plugin");
  const repository = join(root, "repository");
  const bin = join(root, "bin");
  const previousPath = process.env.PATH;
  await mkdir(plugin); await mkdir(repository); await mkdir(bin);
  for (const name of ["index.server.ts", "index.client.tsx", "paseo-plugin.json", "server", "shared", "client"]) {
    await cp(join(pluginPath, name), join(plugin, name), { recursive: true });
  }
  function git(...args: string[]) { return execFileSync("git", ["-C", repository, ...args], { encoding: "utf8" }).trim(); }
  git("init", "-b", "feature");
  git("-c", "user.name=Test", "-c", "user.email=test@example.com", "commit", "--allow-empty", "-m", "Feature");
  git("remote", "add", "origin", "https://github.com/example/celebration-fixture.git");
  const sha = git("rev-parse", "HEAD");
  const statePath = join(root, "pr.json");
  const pr = { number: 7, title: "Ship feature", url: "https://github.com/example/celebration-fixture/pull/7", state: "MERGED", mergedAt: "2026-01-01T00:00:00Z", headRefOid: sha, closingIssuesReferences: [{ number: 3, url: "https://github.com/example/celebration-fixture/issues/3" }] };
  await writeFile(statePath, JSON.stringify(pr));
  const ghPath = join(bin, "gh");
  await writeFile(ghPath, `#!${process.execPath}\nconst fs = require("fs"); const pr = JSON.parse(fs.readFileSync(${JSON.stringify(statePath)}, "utf8")); const args = process.argv.slice(2); if(pr.error) process.exit(1); console.log(JSON.stringify(args[0] === "pr" ? pr : args[1].includes("/issues/") ? {number:3,title:"Issue recap",body:"Shipped the requested change."} : [{number:7,head:{sha:pr.headRefOid}}]));\n`);
  await chmod(ghPath, 0o755);
  process.env.PATH = `${bin}:${previousPath}`;
  const daemon = await createTestPaseoDaemon({ daemonVersion: "0.11.2", pluginsEnabled: true });
  const client = new DaemonClient({ url: `ws://127.0.0.1:${daemon.port}/ws`, appVersion: "0.11.2" });
  try {
    await client.connect();
    const installed = await client.installDirectoryPlugin(plugin);
    expect(installed.status).toBe("running");
    const created = await client.createWorkspace({ source: { kind: "directory", path: repository } });
    expect(created.error).toBeNull();
    const id = created.workspace!.id;
    const poll = (baseline: boolean) => client.invokePluginRpc("paseo-merge-celebration", "celebrations.poll", { session: "live", baseline });
    expect(await poll(true)).toEqual({ events: [] });
    expect((await client.archiveWorkspace(id)).error).toBeNull();
    await expect.poll(() => poll(false), { timeout: 15_000, interval: 100 }).toMatchObject({ events: [{ title: "Ship feature", issues: [{ number: 3, title: "Issue recap", summary: "Shipped the requested change." }] }] });
    expect(await poll(false)).toEqual({ events: [] });
    await client.archiveWorkspace(id);
    expect(await poll(false)).toEqual({ events: [] });
    expect(await client.invokePluginRpc("paseo-merge-celebration", "celebrations.poll", { session: "reconnected", baseline: true })).toEqual({ events: [] });
    await client.reloadPlugin("paseo-merge-celebration");
    expect(await poll(true)).toEqual({ events: [] });
    // A second workspace on the same repo represents manual archiving of an open PR.
    await writeFile(statePath, JSON.stringify({ ...pr, state: "OPEN", mergedAt: null }));
    const unmerged = await client.createWorkspace({ source: { kind: "directory", path: repository } });
    expect(unmerged.error).toBeNull();
    expect((await client.archiveWorkspace(unmerged.workspace!.id)).error).toBeNull();
    // Await a normal RPC round-trip and confirm no event was published after verification.
    await new Promise((resolve) => setTimeout(resolve, 1000));
    expect(await poll(false)).toEqual({ events: [] });
    const logs = await client.getPluginLogs("paseo-merge-celebration");
    expect(logs.filter((entry) => entry.message.includes("Merge verification failed"))).toEqual([]);
    await writeFile(statePath, JSON.stringify({ ...pr, error: true }));
    const unavailable = await client.createWorkspace({ source: { kind: "directory", path: repository } });
    expect(unavailable.error).toBeNull();
    expect((await client.archiveWorkspace(unavailable.workspace!.id)).error).toBeNull();
    await expect.poll(async () => (await client.getPluginLogs("paseo-merge-celebration")).some((entry) => entry.message.includes("Merge verification failed")), { timeout: 5000 }).toBe(true);
    expect(await poll(false)).toEqual({ events: [] });
    expect((await client.listPlugins()).find((entry) => entry.id === "paseo-merge-celebration")?.status).toBe("running");
  } catch (error) { console.error("Plugin logs", await client.getPluginLogs("paseo-merge-celebration")); throw error; } finally {
    process.env.PATH = previousPath;
    await client.close(); await daemon.close();
    await rm(root, { recursive: true, force: true });
  }
}, 60_000);
